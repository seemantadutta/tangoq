<!--
Description:
  Options for the full deck.

  Tango DJ build: the deck-content toggles unrelated to playing a tanda set
  (Hotcues, Loop, Beatjump, Key, Vinyl) are removed here, and their controls are
  force-hidden in skin.xml. What remains is the cue points, the spinny/cover art,
  and the Rate Controls (opt-in, default off) for nudging alt/nuevo tracks.
-->
<Template>
  <WidgetGroup>
    <ObjectName>SkinSettingsCategory</ObjectName>
    <SizePolicy>me,min</SizePolicy>
    <Layout>vertical</Layout>
    <Children>

      <!-- Intro & Outro cues - hidden in Tango DJ mode, where the deck's
           "Set Start" button replaces the group of four. Hiding the entry as
           well as the buttons means a Tango DJ is never left with the buttons
           showing and no way to turn them off. The setting's value is never
           written, so leaving Tango restores whatever the DJ had. -->
      <WidgetGroup>
        <SizePolicy>me,min</SizePolicy>
        <Layout>vertical</Layout>
        <Children>
          <Template src="skins:TangoQ/helpers/skin_settings_button_2state.xml">
            <SetVariable name="TooltipId">show_intro_outro_cues</SetVariable>
            <SetVariable name="Text">Intro &amp; Outro Cues</SetVariable>
            <SetVariable name="Setting">[Skin],show_intro_outro_cues</SetVariable>
          </Template>
        </Children>
        <Connection>
          <ConfigKey>[AutoDJ],keep_queue</ConfigKey>
          <Transform><Not/></Transform>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup>

      <WidgetGroup><Size>0me,5f</Size></WidgetGroup>

      <!-- Rate Controls: the rate/tempo slider, opt-in (default off in
           skin.xml) for the minority of alt/nuevo tracks that need a speed
           nudge. Rate Adjust Buttons is the dependent sub-item, greyed out
           while Rate Controls is off, exactly as in stock Mixxx. -->
      <Template src="skins:TangoQ/helpers/skin_settings_button_2state.xml">
        <SetVariable name="TooltipId">show_rate_controls</SetVariable>
        <SetVariable name="Text">Rate Controls</SetVariable>
        <SetVariable name="Setting">[Skin],show_rate_controls</SetVariable>
      </Template>

      <WidgetGroup>
        <ObjectName>SkinSettingsSubMenu</ObjectName>
        <Layout>stacked</Layout>
        <Size>180min,18f</Size>
        <Children>
          <!-- translucent cover while Rate Controls is off -->
          <Template src="skins:TangoQ/helpers/skin_settings_cover_inverted.xml">
            <SetVariable name="Setting">[Skin],show_rate_controls</SetVariable>
          </Template>
          <Template src="skins:TangoQ/helpers/skin_settings_button_2state.xml">
            <SetVariable name="TooltipId">show_rate_control_buttons</SetVariable>
            <SetVariable name="Text">Rate Adjust Buttons</SetVariable>
            <SetVariable name="Setting">[Skin],show_rate_control_buttons</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

      <WidgetGroup><Size>0me,5f</Size></WidgetGroup>

      <!-- Spinny -->
      <Template src="skins:TangoQ/helpers/skin_settings_button_2state.xml">
        <SetVariable name="TooltipId">show_spinny</SetVariable>
        <SetVariable name="Text">Spinny</SetVariable>
        <SetVariable name="Setting">[Skin],show_spinnies</SetVariable>
      </Template>

      <!-- Cover Art -->
      <Template src="skins:TangoQ/helpers/skin_settings_button_2state.xml">
        <SetVariable name="TooltipId">show_coverart</SetVariable>
        <SetVariable name="Text">Cover Art</SetVariable>
        <SetVariable name="Setting">[Skin],show_coverart</SetVariable>
      </Template>

      <!-- Big Spinny / Cover Art -->
      <WidgetGroup>
        <ObjectName>SkinSettingsSubMenu</ObjectName>
        <Layout>stacked</Layout>
        <Size>180min,18f</Size>
        <Children>
          <!-- translucent cover when neither Spinny nor Cover is shown -->
          <Template src="skins:TangoQ/helpers/skin_settings_cover_inverted.xml">
            <SetVariable name="Setting">[Skin],show_spinny_or_cover</SetVariable>
          </Template>
          <Template src="skins:TangoQ/helpers/skin_settings_button_2state.xml">
            <SetVariable name="TooltipId">show_coverart</SetVariable>
            <SetVariable name="Text">Big Spinny/Cover Art</SetVariable>
            <SetVariable name="Setting">[Skin],select_big_spinny_or_cover</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
