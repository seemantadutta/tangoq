  <layout class="QVBoxLayout" name="AutoDJGridLayout">

   <item>
    <widget class="QGroupBox" name="TangoOptions">
      <property name="title">
       <string>Tango DJ Mode</string>
      </property>
      <property name="alignment">
       <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
      </property>
      <layout class="QVBoxLayout" name="TangoLayout">
       <item>
        <widget class="QCheckBox" name="TangoModeCheckBox">
         <property name="toolTip">
          <string>Can only be changed while Auto DJ is stopped, whether from here, the keyboard shortcut or a controller.</string>
         </property>
         <property name="text">
          <string>Enable Tango DJ mode (Ctrl+Alt+Shift+T)</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="TangoModeHelpLabel">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Plays the Auto DJ list in order, keeps played tracks, and stops at the end. Locks shuffle, skip, random, re-queue and list sorting. Trims silence and adds a 3-second gap between tracks by default — you can still change the fade mode and gap in the Auto DJ toolbar. Can only be changed while Auto DJ is stopped.</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="CortinaLengthLayout">
         <item>
          <widget class="QLabel" name="CortinaLengthLabel">
           <property name="text">
            <string>Default cortina length</string>
           </property>
           <property name="buddy">
            <cstring>CortinaLengthSpinBox</cstring>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QSpinBox" name="CortinaLengthSpinBox">
           <property name="toolTip">
            <string>Cortina length budget. In Cortina Fade mode it is the on-deck envelope length (fade-in + hold + fade-out); otherwise it is the play time assumed when estimating the set length and end time. This field is the default and can only be changed here while Auto DJ is stopped; during a set, nudge it live with the − / + buttons in the Auto DJ toolbar.</string>
           </property>
           <property name="suffix">
            <string> s</string>
           </property>
           <property name="minimum">
            <number>5</number>
           </property>
           <property name="maximum">
            <number>600</number>
           </property>
           <property name="value">
            <number>45</number>
           </property>
           <property name="minimumSize">
            <size>
             <width>70</width>
             <height>0</height>
            </size>
           </property>
           <property name="maximumSize">
            <size>
             <width>90</width>
             <height>16777215</height>
            </size>
           </property>
          </widget>
         </item>
         <item>
          <spacer name="horizontalSpacerCortina">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Minimum">
             <horstretch>1</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
          </spacer>
         </item>
        </layout>
       </item>
       <item>
        <layout class="QHBoxLayout" name="CortinaFadeModeLayout">
         <item>
          <widget class="QLabel" name="CortinaFadeModeLabel">
           <property name="text">
            <string>Cortina transition</string>
           </property>
           <property name="buddy">
            <cstring>CortinaFadeModeComboBox</cstring>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="CortinaFadeModeComboBox">
           <property name="toolTip">
            <string>How cortinas are played. &quot;Hard cut&quot; keeps the current behavior (the cortina starts at full volume and is faded out manually with the crossfader). &quot;Cortina Fade&quot; automatically fades the cortina in and out using the times below. Can only be changed while Auto DJ is stopped.</string>
           </property>
           <item>
            <property name="text">
             <string>Hard cut (manual fade-out)</string>
            </property>
           </item>
           <item>
            <property name="text">
             <string>Cortina Fade (auto fade in/out)</string>
            </property>
           </item>
          </widget>
         </item>
         <item>
          <spacer name="horizontalSpacerCortinaFadeMode">
           <property name="orientation">
            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizePolicy">
